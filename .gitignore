# ---------------------------------------------------------------------------
# .gitignore for C# / .NET projects
# Based on the Microsoft VisualStudio template, trimmed and adapted.
# ---------------------------------------------------------------------------

# ----- Build output --------------------------------------------------------
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
msbuild.log
msbuild.err
msbuild.wrn

# ----- .NET tooling --------------------------------------------------------
project.lock.json
project.fragment.lock.json
artifacts/

# Roslyn cache / generated files
*.suo
*.user
*.userosscache
*.sln.docstates
*.dotCover
*.coverage
*.coveragexml

# Visual Studio cache files
.vs/
*.VC.db
*.VC.VC.opendb

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Entity Framework / Migrations scaffolding
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# ----- Editor / IDE --------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider / ReSharper
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# MonoDevelop / Xamarin Studio
*.pidb
*.userprefs

# ----- OS files ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ----- Misc ----------------------------------------------------------------
*.swp
*.swo
*.tmp
*.bak
*.orig
*.log

# Environment / secrets
.env
.env.local
*.local.json
secrets.json
appsettings.*.Development.json

# ----- Project-specific ----------------------------------------------------
# Don't commit user-supplied inference inputs/outputs
input.jpg
input.jpeg
input.png
output/
checkpoints/
*.pt
*.pth
*.onnx

# Tokenizer assets that should be downloaded, not checked in
vocab.json
merges.txt
